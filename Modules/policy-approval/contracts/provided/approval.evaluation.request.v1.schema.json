{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/approval.evaluation.request.v1.schema.json",
  "title": "approval.evaluation.request/v1",
  "description": "Signed Control Plane request for one Policy Approval evaluation of one exact action.proposal/v2 commitment. valid_until is exactly occurred_at plus 120 seconds and occurred_at equals the bound proposal's occurred_at; the idempotency commitment is the SHA-256 of the unsigned canonical bytes under domain dps.policy-approval.approval-evaluation-request/v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "producer_module",
    "auth_scope",
    "proposal_id",
    "proposal_sha256",
    "soul_id",
    "device_binding_id",
    "platform_account_id",
    "trace_id",
    "idempotency_key",
    "release_bom_sha256",
    "mode",
    "execution_promotion_sha256",
    "occurred_at",
    "valid_until",
    "privacy_class",
    "signature_base64"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "approval.evaluation.request/v1"},
    "producer_module": {"const": "control-plane-host"},
    "auth_scope": {"const": "policy:evaluate"},
    "proposal_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])", "not": {"const": "00000000-0000-0000-0000-000000000000"}},
    "proposal_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "soul_id": {"type": "string", "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"},
    "device_binding_id": {"type": "string", "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"},
    "platform_account_id": {"type": "string", "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"},
    "trace_id": {"type": "string", "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"},
    "idempotency_key": {"type": "string", "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"},
    "release_bom_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "mode": {"enum": ["SHADOW", "EXECUTE"]},
    "execution_promotion_sha256": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"}]},
    "occurred_at": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{0,6}[1-9])?Z$(?![\\s\\S])"},
    "valid_until": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{0,6}[1-9])?Z$(?![\\s\\S])"},
    "privacy_class": {"const": "internal"},
    "signature_base64": {"type": "string", "minLength": 88, "maxLength": 88, "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$(?![\\s\\S])"}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "SHADOW"}}, "required": ["mode"]}, "then": {"properties": {"execution_promotion_sha256": {"type": "null"}}}},
    {"if": {"properties": {"mode": {"const": "EXECUTE"}}, "required": ["mode"]}, "then": {"properties": {"execution_promotion_sha256": {"type": "string"}}}}
  ]
}
