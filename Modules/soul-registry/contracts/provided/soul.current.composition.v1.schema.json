{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/soul.current.composition.v1.schema.json",
  "title": "soul.current.composition/v1",
  "description": "Untrusted installation data only. Native protection, cryptographic verification and fresh owner state are separate required checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "configuration_sha256",
    "host_artifact_sha256",
    "soul_artifact_sha256",
    "contracts_artifact_sha256",
    "release_bom_sha256",
    "release_generation",
    "issuer",
    "key_role",
    "key_id",
    "issued_at",
    "expires_at",
    "signature_algorithm",
    "signature_base64"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_id": {
      "const": "soul.current.composition/v1"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "host_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "soul_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "contracts_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "release_bom_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "release_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "issuer": {
      "const": "dps-soul-current-installation"
    },
    "key_role": {
      "const": "installation-root"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$(?![\\s\\S])"
    },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$(?![\\s\\S])",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$(?![\\s\\S])",
      "format": "date-time"
    },
    "signature_algorithm": {
      "const": "ES256-P1363-SHA256"
    },
    "signature_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$(?![\\s\\S])"
    }
  }
}
