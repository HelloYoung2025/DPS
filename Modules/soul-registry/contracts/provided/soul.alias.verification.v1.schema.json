{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/soul.alias.verification.v1.schema.json",
  "title": "soul.alias.verification/v1",
  "description": "Untrusted owner contract data only. No provider, signature authority or current lease is issued by schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "producer_module",
    "proof_id",
    "tenant_ref",
    "operation",
    "alias_kind",
    "alias_digest",
    "alias_key_id",
    "alias_key_epoch",
    "target_soul_id",
    "device_binding_id",
    "platform_account_id",
    "trace_id",
    "idempotency_key",
    "occurred_at",
    "privacy_class",
    "request_sha256",
    "issuer",
    "audience",
    "key_role",
    "key_id",
    "trust_epoch",
    "revocation_epoch",
    "release_bom_sha256",
    "release_generation",
    "issued_at",
    "expires_at",
    "nonce",
    "signature_algorithm",
    "signature_base64"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_id": {
      "const": "soul.alias.verification/v1"
    },
    "producer_module": {
      "const": "soul-registry"
    },
    "proof_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "tenant_ref": {
      "type": "string",
      "pattern": "^tenant_[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 71,
      "maxLength": 71
    },
    "operation": {
      "enum": [
        "create",
        "attach",
        "resolve",
        "revoke"
      ]
    },
    "alias_kind": {
      "enum": [
        "email",
        "phone",
        "platform_id"
      ]
    },
    "alias_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 64,
      "maxLength": 64
    },
    "alias_key_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$(?![\\s\\S])",
      "minLength": 1,
      "maxLength": 64
    },
    "alias_key_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "target_soul_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])",
          "minLength": 69,
          "maxLength": 69
        },
        {
          "type": "null"
        }
      ]
    },
    "device_binding_id": {
      "type": "string",
      "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])",
      "minLength": 35,
      "maxLength": 35
    },
    "platform_account_id": {
      "type": "string",
      "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])",
      "minLength": 35,
      "maxLength": 35
    },
    "trace_id": {
      "type": "string",
      "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])",
      "minLength": 38,
      "maxLength": 38
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 69,
      "maxLength": 69
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{7}Z$(?![\\s\\S])",
      "minLength": 28,
      "maxLength": 28,
      "format": "date-time"
    },
    "privacy_class": {
      "const": "sensitive"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 64,
      "maxLength": 64
    },
    "issuer": {
      "const": "dps-soul-alias-authority"
    },
    "audience": {
      "const": "soul-registry"
    },
    "key_role": {
      "const": "alias-verification"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$(?![\\s\\S])",
      "minLength": 1,
      "maxLength": 64
    },
    "trust_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "release_bom_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 64,
      "maxLength": 64
    },
    "release_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "issued_at": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{7}Z$(?![\\s\\S])",
      "minLength": 28,
      "maxLength": 28,
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{7}Z$(?![\\s\\S])",
      "minLength": 28,
      "maxLength": 28,
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "pattern": "^nonce_[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 70,
      "maxLength": 70
    },
    "signature_algorithm": {
      "const": "ES256-P1363-SHA256"
    },
    "signature_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$(?![\\s\\S])",
      "minLength": 88,
      "maxLength": 88
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "create"
          }
        }
      },
      "then": {
        "properties": {
          "target_soul_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "target_soul_id": {
            "type": "string",
            "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])",
            "minLength": 69,
            "maxLength": 69
          }
        }
      }
    }
  ]
}
