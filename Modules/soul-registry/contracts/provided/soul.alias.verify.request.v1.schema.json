{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/soul.alias.verify.request.v1.schema.json",
  "title": "soul.alias.verify.request/v1",
  "description": "Untrusted owner contract data only. No provider, signature authority or current lease is issued by schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "producer_module",
    "request_id",
    "tenant_ref",
    "operation",
    "alias_kind",
    "proof_ref",
    "target_soul_id",
    "device_binding_id",
    "platform_account_id",
    "trace_id",
    "idempotency_key",
    "occurred_at",
    "privacy_class",
    "nonce"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_id": {
      "const": "soul.alias.verify.request/v1"
    },
    "producer_module": {
      "const": "control-plane-host"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "tenant_ref": {
      "type": "string",
      "pattern": "^tenant_[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 71,
      "maxLength": 71
    },
    "operation": {
      "enum": [
        "create",
        "attach",
        "resolve",
        "revoke"
      ]
    },
    "alias_kind": {
      "enum": [
        "email",
        "phone",
        "platform_id"
      ]
    },
    "proof_ref": {
      "type": "string",
      "pattern": "^proof_[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 70,
      "maxLength": 70
    },
    "target_soul_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])",
          "minLength": 69,
          "maxLength": 69
        },
        {
          "type": "null"
        }
      ]
    },
    "device_binding_id": {
      "type": "string",
      "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])",
      "minLength": 35,
      "maxLength": 35
    },
    "platform_account_id": {
      "type": "string",
      "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])",
      "minLength": 35,
      "maxLength": 35
    },
    "trace_id": {
      "type": "string",
      "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])",
      "minLength": 38,
      "maxLength": 38
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 69,
      "maxLength": 69
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{7}Z$(?![\\s\\S])",
      "minLength": 28,
      "maxLength": 28,
      "format": "date-time"
    },
    "privacy_class": {
      "const": "sensitive"
    },
    "nonce": {
      "type": "string",
      "pattern": "^nonce_[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 70,
      "maxLength": 70
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "create"
          }
        }
      },
      "then": {
        "properties": {
          "target_soul_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "target_soul_id": {
            "type": "string",
            "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])",
            "minLength": 69,
            "maxLength": 69
          }
        }
      }
    }
  ]
}
