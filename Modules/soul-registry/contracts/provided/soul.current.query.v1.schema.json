{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/soul.current.query.v1.schema.json",
  "title": "soul.current.query/v1",
  "description": "Untrusted owner contract data only. No provider, signature authority or current lease is issued by schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "producer_module",
    "request_id",
    "tenant_ref",
    "soul_id",
    "device_binding_id",
    "platform_account_id",
    "trace_id",
    "idempotency_key",
    "occurred_at",
    "privacy_class",
    "purpose",
    "expected_resolution_revision",
    "nonce"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_id": {
      "const": "soul.current.query/v1"
    },
    "producer_module": {
      "enum": [
        "binding",
        "control-plane-host",
        "policy-approval",
        "memory-event-ledger"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "tenant_ref": {
      "type": "string",
      "pattern": "^tenant_[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 71,
      "maxLength": 71
    },
    "soul_id": {
      "type": "string",
      "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 69,
      "maxLength": 69
    },
    "device_binding_id": {
      "type": "string",
      "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])",
      "minLength": 35,
      "maxLength": 35
    },
    "platform_account_id": {
      "type": "string",
      "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])",
      "minLength": 35,
      "maxLength": 35
    },
    "trace_id": {
      "type": "string",
      "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])",
      "minLength": 38,
      "maxLength": 38
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 69,
      "maxLength": 69
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{7}Z$(?![\\s\\S])",
      "minLength": 28,
      "maxLength": 28,
      "format": "date-time"
    },
    "privacy_class": {
      "const": "sensitive"
    },
    "purpose": {
      "enum": [
        "binding-activate",
        "identity-read",
        "policy-shadow-evaluate",
        "ledger-append"
      ]
    },
    "expected_resolution_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        {
          "type": "null"
        }
      ]
    },
    "nonce": {
      "type": "string",
      "pattern": "^nonce_[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 70,
      "maxLength": 70
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "producer_module": {
            "const": "binding"
          }
        }
      },
      "then": {
        "properties": {
          "purpose": {
            "const": "binding-activate"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "producer_module": {
            "const": "control-plane-host"
          }
        }
      },
      "then": {
        "properties": {
          "purpose": {
            "const": "identity-read"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "producer_module": {
            "const": "policy-approval"
          }
        }
      },
      "then": {
        "properties": {
          "purpose": {
            "const": "policy-shadow-evaluate"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "producer_module": {
            "const": "memory-event-ledger"
          }
        }
      },
      "then": {
        "properties": {
          "purpose": {
            "const": "ledger-append"
          }
        }
      }
    }
  ]
}
