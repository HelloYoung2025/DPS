{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/soul.current.authority-state.v1.schema.json",
  "title": "soul.current.authority-state/v1",
  "description": "Untrusted installation data only. Native protection, cryptographic verification and fresh owner state are separate required checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "configuration_sha256",
    "tenant_ref",
    "soul_id",
    "principal_id",
    "permission",
    "status",
    "authorization_revision",
    "trust_epoch",
    "key_revocation_epoch",
    "release_bom_sha256",
    "release_generation",
    "host_auth_key_id",
    "current_key_id",
    "status_key_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_id": {
      "const": "soul.current.authority-state/v1"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "tenant_ref": {
      "type": "string",
      "pattern": "^tenant_[a-f0-9]{64}$(?![\\s\\S])"
    },
    "soul_id": {
      "type": "string",
      "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"
    },
    "principal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$(?![\\s\\S])"
    },
    "permission": {
      "const": "soul-current.identity-read"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "REVOKED"
      ]
    },
    "authorization_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "trust_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "key_revocation_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "release_bom_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "release_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "host_auth_key_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$(?![\\s\\S])"
    },
    "current_key_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$(?![\\s\\S])"
    },
    "status_key_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$(?![\\s\\S])"
    }
  }
}
