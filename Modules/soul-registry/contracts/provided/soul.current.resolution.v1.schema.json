{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/contracts/soul.current.resolution.v1.schema.json",
  "title": "soul.current.resolution/v1",
  "description": "Untrusted owner contract data only. No provider, signature authority or current lease is issued by schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "producer_module",
    "proof_id",
    "tenant_ref",
    "soul_id",
    "device_binding_id",
    "platform_account_id",
    "trace_id",
    "idempotency_key",
    "occurred_at",
    "privacy_class",
    "query_sha256",
    "status",
    "resolution_revision",
    "resolution_canonicalizer_id",
    "resolution_sha256",
    "resolution",
    "issuer",
    "audience",
    "key_role",
    "key_id",
    "trust_epoch",
    "revocation_epoch",
    "release_bom_sha256",
    "release_generation",
    "issued_at",
    "expires_at",
    "nonce",
    "signature_algorithm",
    "signature_base64"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_id": {
      "const": "soul.current.resolution/v1"
    },
    "producer_module": {
      "const": "soul-registry"
    },
    "proof_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "tenant_ref": {
      "type": "string",
      "pattern": "^tenant_[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 71,
      "maxLength": 71
    },
    "soul_id": {
      "type": "string",
      "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 69,
      "maxLength": 69
    },
    "device_binding_id": {
      "type": "string",
      "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])",
      "minLength": 35,
      "maxLength": 35
    },
    "platform_account_id": {
      "type": "string",
      "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])",
      "minLength": 35,
      "maxLength": 35
    },
    "trace_id": {
      "type": "string",
      "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])",
      "minLength": 38,
      "maxLength": 38
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 69,
      "maxLength": 69
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{7}Z$(?![\\s\\S])",
      "minLength": 28,
      "maxLength": 28,
      "format": "date-time"
    },
    "privacy_class": {
      "const": "sensitive"
    },
    "query_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 64,
      "maxLength": 64
    },
    "status": {
      "enum": [
        "ACTIVE",
        "REVOKED"
      ]
    },
    "resolution_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "resolution_canonicalizer_id": {
      "const": "soul.resolved.ledger-audit/v1"
    },
    "resolution_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 64,
      "maxLength": 64
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_id",
        "producer_module",
        "soul_id",
        "device_binding_id",
        "platform_account_id",
        "trace_id",
        "idempotency_key",
        "occurred_at",
        "privacy_class",
        "alias_kind",
        "alias_digest",
        "alias_key_id"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "contract_id": {
          "const": "soul.resolved/v1"
        },
        "producer_module": {
          "const": "soul-registry"
        },
        "soul_id": {
          "type": "string",
          "pattern": "^soul_[a-f0-9]{64}$(?![\\s\\S])"
        },
        "device_binding_id": {
          "type": "string",
          "pattern": "^db_[a-f0-9]{32}$(?![\\s\\S])"
        },
        "platform_account_id": {
          "type": "string",
          "pattern": "^pa_[a-f0-9]{32}$(?![\\s\\S])"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^trace_[a-f0-9]{32}$(?![\\s\\S])"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^idem_[a-f0-9]{64}$(?![\\s\\S])"
        },
        "occurred_at": {
          "type": "string",
          "maxLength": 32,
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{0,6}[1-9])?Z$(?![\\s\\S])"
        },
        "privacy_class": {
          "const": "pseudonymous"
        },
        "alias_kind": {
          "enum": [
            "email",
            "phone",
            "platform_id"
          ]
        },
        "alias_digest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])",
          "description": "HMAC-SHA256 digest of a normalized, tenant-scoped alias."
        },
        "alias_key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$(?![\\s\\S])",
          "description": "Non-secret identifier of the HMAC key used for alias_digest."
        }
      }
    },
    "issuer": {
      "const": "dps-soul-current-authority"
    },
    "audience": {
      "enum": [
        "binding",
        "control-plane-host",
        "policy-approval",
        "memory-event-ledger"
      ]
    },
    "key_role": {
      "const": "soul-current"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$(?![\\s\\S])",
      "minLength": 1,
      "maxLength": 64
    },
    "trust_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "release_bom_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 64,
      "maxLength": 64
    },
    "release_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "issued_at": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{7}Z$(?![\\s\\S])",
      "minLength": 28,
      "maxLength": 28,
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{7}Z$(?![\\s\\S])",
      "minLength": 28,
      "maxLength": 28,
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "pattern": "^nonce_[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 70,
      "maxLength": 70
    },
    "signature_algorithm": {
      "const": "ES256-P1363-SHA256"
    },
    "signature_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$(?![\\s\\S])",
      "minLength": 88,
      "maxLength": 88
    }
  }
}
