{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dps.local/schemas/legacy-zennodroid-entrypoints.v1.schema.json",
  "title": "DPS legacy ZennoDroid entrypoint inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_scope",
    "entry_count",
    "entries",
    "unknown_entrypoint_behavior",
    "production_load_policy",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "dps.legacy-zennodroid-entrypoints/v1"},
    "inventory_scope": {"const": "ALL_ZDPROJECTS_CSHARP"},
    "entry_count": {"type": "integer", "minimum": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "classification",
          "production_loadable",
          "required_gate",
          "reason"
        ],
        "properties": {
          "path": {"type": "string", "pattern": "^ZDProjects/.+\\.[cC][sS]$"},
          "classification": {
            "enum": [
              "PRODUCTION_FAIL_CLOSED",
              "DYNAMIC_LOADER_DISABLED",
              "QUARANTINE_ONLY_FIXTURE"
            ]
          },
          "production_loadable": {"type": "boolean"},
          "required_gate": {
            "type": ["string", "null"],
            "enum": [
              "LEGACY_DISABLE_NEW_COMMANDS=true",
              "LEGACY_DYNAMIC_LOADER_DISABLED=true",
              null
            ]
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "unknown_entrypoint_behavior": {"const": "REJECT"},
    "production_load_policy": {"const": "MANIFEST_EXACT_SET_ONLY"},
    "limitations": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
