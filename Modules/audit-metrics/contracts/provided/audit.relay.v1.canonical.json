  "validation_boundary": {
    "receipt_hash_entry": "CommandReceiptV1.Validate before encoding; full exact rules in README. ResultCode text validation is weaker than successful Audit event label validation. Nullable native Guid.Empty is not rejected.",
    "relay_encoding_entry": "Checks envelope object non-null only; encoding is not authorization.",
    "relay_verify_entry": "UTC now/expiry, lowercase digest shapes, matching ReceiptId, ExpiresAt >= now, recomputed Audit digest, Base64 decode and P-256 signature verification.",
    "ingestion_entry": "Additionally exact command-orchestrator caller and audit:command-receipt scope; derived Audit event/labels validation; production independently trusted current BOM/key state. Current ResultCode .NET regex ^[A-Za-z0-9._:-]+$ can match before one terminal LF, so an otherwise valid VERIFIED followed by U+000A can pass current label checks within the length limit; this is not an absolute-end constraint. The frame retains the LF byte 0a and includes it in the byte length. No trimming, stricter rejection or product change is proposed here.",
    "not_specified": "No new JSON relay parser/Schema, trust-state or stored-event canonical profile, or wire precision policy beyond typed DateTimeOffset."
  },
